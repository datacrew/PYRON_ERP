# ERP Mittelstand – Zeitplan der Datensicherung (täglich; install.sh setzt die Uhrzeit ein)
[Unit]
Description=ERP Mittelstand – tägliche Datensicherung

[Timer]
OnCalendar=*-*-* __UHRZEIT__:00
# verpasste Läufe (Server war aus) nach dem Start nachholen
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
