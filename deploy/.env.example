# =====================================================================================
# ERP Mittelstand – Konfiguration für den Produktivbetrieb
#
# Docker-Weg:  diese Datei nach deploy/.env kopieren und ALLE mit <...> markierten Werte ersetzen.
#              cp .env.example .env && chmod 600 .env
# Nativer Weg: install.sh erzeugt die .env automatisch (zufälliger SECRET_KEY und DB-Passwort).
#
# Die .env enthält Geheimnisse – niemals in Git einchecken, nie per E-Mail verschicken.
# =====================================================================================

# ------------------------------------------------------------------ Domain / HTTPS
# Öffentliche Domain, unter der das ERP erreichbar ist. Der DNS-A-/AAAA-Eintrag muss auf den Server zeigen,
# sonst kann Caddy kein Let's-Encrypt-Zertifikat beziehen.
DOMAIN=<erp.ihre-firma.de>
# E-Mail-Adresse für Let's Encrypt (Ablaufwarnungen, Kontakt bei Problemen)
ACME_EMAIL=<it@ihre-firma.de>

# ------------------------------------------------------------------ Django-Grundeinstellungen
# 0 = Produktivbetrieb (Pflicht!). 1 nur für Entwicklung – zeigt Fehlerdetails öffentlich an.
DJANGO_DEBUG=0
# Geheimer Schlüssel (mind. 40 Zeichen, zufällig). Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Wechsel meldet alle Benutzer ab; bereits ausgegebene Passwort-Zurücksetzen-Links werden ungültig.
DJANGO_SECRET_KEY=<hier-zufaelligen-schluessel-einsetzen>
# Erlaubte Hostnamen (kommagetrennt) – normalerweise genau die DOMAIN
DJANGO_ALLOWED_HOSTS=<erp.ihre-firma.de>
# Vertrauenswürdige Ursprünge für CSRF – mit https:// davor
DJANGO_CSRF_TRUSTED_ORIGINS=<https://erp.ihre-firma.de>
# Anwendung läuft hinter HTTPS-Proxy (Caddy): sichere Cookies, Weiterleitung auf HTTPS
ERP_HTTPS=1
# HTTP Strict Transport Security in Sekunden. Erst aktivieren, wenn HTTPS stabil läuft!
# Empfehlung nach erfolgreichem Test: 31536000 (1 Jahr). 0 = aus.
DJANGO_HSTS_SEKUNDEN=0
# HSTS auch für Subdomains (nur setzen, wenn ALLE Subdomains HTTPS haben)
DJANGO_HSTS_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
# Sitzungsdauer in Sekunden (Standard 10 Stunden = ein Arbeitstag)
ERP_SITZUNG_SEKUNDEN=36000

# ------------------------------------------------------------------ Datenbank (PostgreSQL 17)
POSTGRES_DB=erp
POSTGRES_USER=erp
# Langes zufälliges Passwort, z. B.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=<hier-langes-zufaelliges-passwort>
# Docker: „postgres“ (Dienstname) – wird in docker-compose.prod.yml ohnehin gesetzt. Nativ: localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------ Start-Verhalten (Docker)
# Grunddaten (Module, Rollen, Kontenrahmen SKR03, Nummernkreise) beim Start anlegen – idempotent
ERP_GRUNDDATEN=1
# Demodaten mit BEKANNTEN Passwörtern – im Produktivsystem IMMER 0!
ERP_DEMODATEN=0

# ------------------------------------------------------------------ Fachliche Einstellungen
# Gesetzlicher Mindestlohn in €/h (Untergrenze der Akkord-/Zeitlohngarantie).
# Stand 01.01.2026: 13.90 – ab 01.01.2027 voraussichtlich 14.60. Bei jeder Erhöhung anpassen!
ERP_MINDESTLOHN=13.90
# Lohnsatz €/h für die Soll-Kalkulation, falls zur Lohngruppe kein Mitarbeiter-Richtsatz vorliegt
ERP_STANDARD_LOHNSATZ=18.00
# Eigene GLN/ILN für EDI/EDIFACT (von GS1 Germany)
ERP_EIGENE_GLN=<ihre-13-stellige-gln>
# DATEV-Export: Berater- und Mandantennummer laut Steuerberater
ERP_DATEV_BERATERNUMMER=<beraternummer>
ERP_DATEV_MANDANTENNUMMER=<mandantennummer>

# ------------------------------------------------------------------ Protokollierung / Gunicorn
# Protokollstufe der ERP-Module: DEBUG, INFO, WARNING, ERROR
ERP_LOG_LEVEL=INFO
# Optional zusätzlich in Datei protokollieren (Docker: leer lassen, Protokolle über „docker compose logs“)
ERP_LOG_DATEI=
# Anzahl Gunicorn-Prozesse (Faustregel: 2 × CPU-Kerne + 1; leer = automatisch, max. 9)
GUNICORN_WORKERS=
# Zeitlimit je Anfrage in Sekunden (große PDF-Läufe/Berichte)
GUNICORN_TIMEOUT=120

# ------------------------------------------------------------------ Dokumentenmanagement (DMS)
# Eingangsordner (Hotfolder) auf dem Server – Docker: Verzeichnis relativ zu deploy/ oder absolut;
# nativ setzt install.sh ERP_DMS_EINGANG=/var/lib/erp/eingang
DMS_EINGANG_HOST_VERZEICHNIS=./eingang
# Tesseract-Sprache(n) und Zeitlimit je Seite (Sekunden)
ERP_DMS_OCR_SPRACHE=deu
ERP_DMS_OCR_TIMEOUT=180

# ------------------------------------------------------------------ Datensicherung
# Uhrzeit der täglichen Sicherung (24-h-Format, Zeitzone Europe/Berlin)
BACKUP_UHRZEIT=02:30
# Verzeichnis auf dem Server, in das der Backup-Container schreibt (relativ zu deploy/ oder absolut)
BACKUP_HOST_VERZEICHNIS=./backups
# Aufbewahrung: Anzahl täglicher, wöchentlicher (Sonntag) und monatlicher (1. des Monats) Sicherungen
BACKUP_TAEGLICH=7
BACKUP_WOECHENTLICH=4
BACKUP_MONATLICH=12
# Beim Start des Backup-Containers sofort eine Sicherung erstellen (1 = ja)
BACKUP_BEIM_START=0
# Optional: externe Kopie (3-2-1-Regel). Nur eines oder beide setzen, leer = keine externe Kopie.
#   rclone: Remote vorher mit „rclone config“ einrichten, rclone.conf nach deploy/rclone/ legen.
#           Beispiel: BACKUP_RCLONE_ZIEL=hetzner-box:erp-backups
#   rsync:  Ziel über SSH, Schlüssel nach deploy/ssh/ legen (id_ed25519 + known_hosts).
#           Beispiel: BACKUP_RSYNC_ZIEL=backup@nas.ihre-firma.de:/volume1/erp-backups/
BACKUP_RCLONE_ZIEL=
BACKUP_RSYNC_ZIEL=
